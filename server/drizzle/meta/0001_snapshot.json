          "value": "\"standard_ingredient\".\"storage_method\" in ('常温', '冷藏', '冷冻')"
        },
        "expiry_source_pairing": {
          "name": "expiry_source_pairing",
          "value": "case\n        when \"standard_ingredient\".\"expiry_date\" is null\n          then case when \"standard_ingredient\".\"expiry_date_source\" is null then 1 else 0 end\n        else case\n          when \"standard_ingredient\".\"expiry_date_source\" is null then 0\n          when \"standard_ingredient\".\"expiry_date_source\" in ('estimated', 'manual') then 1\n          else 0\n        end\n      end"
        },
        "production_not_after_purchase": {
          "name": "production_not_after_purchase",
          "value": "\"standard_ingredient\".\"production_date\" is null or \"standard_ingredient\".\"production_date\" <= \"standard_ingredient\".\"purchase_date\""
        },
        "manual_expiry_not_before_purchase": {
          "name": "manual_expiry_not_before_purchase",
          "value": "case\n        when \"standard_ingredient\".\"expiry_date\" is null then 1\n        when \"standard_ingredient\".\"expiry_date_source\" = 'estimated' then 1\n        when \"standard_ingredient\".\"expiry_date\" >= \"standard_ingredient\".\"purchase_date\" then 1\n        else 0\n      end"
        }
      }
    }
