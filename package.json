{
  "name": "homechef",
  "version": "0.2.3",
  "private": true,
  "description": "HomeChef —— 本地家庭食材库存与菜谱管理",
  "license": "MIT",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
