# ============================================================
# 受保护的一次性诊断脚本（保持**未跟踪**：不得修改、移动、暂存或提交）
#
# ⚠️⚠️ 这里**逐条列出精确路径，刻意不使用 `server/_*.ts` 这类通配符**：
#      `server/_tz-probe.ts` 是 verify-dates.ts 的测试依赖，必须继续跟踪。
#      历史一次性工具在下方逐个列出，避免误伤正式测试。
#
# ⚠️ 其中 `_rebuild-cleanup.ts` 会 `delete from` 清空真实库的库存与食材定义，
#     误提交或误运行后果严重。
# ============================================================
server/_backup-db.ts
server/_backup-prerebuild.ts
server/_crosscheck-migration.ts
server/_diag-500.ts
server/_inspect-seed-tables.ts
server/_readonly-migration-check.ts
server/_rebuild-cleanup.ts
server/_release-facts.ts
server/_verify-rebuild.ts
server/seed/_analyze-data.ts
server/seed/_audit-shelf.ts
server/seed/_audit-units.ts
server/seed/_list-aliases.ts
server/seed/_verify-alias-update.ts

